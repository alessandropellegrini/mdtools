<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/import_markdown"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paste your Markdown table below, or tap 'Paste from Clipboard':"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnDialogPasteClipboard"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paste from Clipboard"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editMarkdownInput"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="top|start"
        android:background="@drawable/cell_background"
        android:padding="12dp"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:hint="| Header 1 | Header 2 |\n| :--- | :---: |\n| Cell 1 | Cell 2 |"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/txtImportError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/delete_btn_color"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:visibility="gone" />

</LinearLayout>
